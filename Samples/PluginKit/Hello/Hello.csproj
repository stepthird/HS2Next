<Project Sdk="Microsoft.NET.Sdk">
  <!-- The plugin kit's first sample (CC0-1.0): an engine-free plugin with one command, a call helper and an event handler.
       Build settings and references come from ..\HS2NextPlugin.props; `dotnet build` stages it into ..\out\stp3.sample.hello\. -->
  <Import Project="..\HS2NextPlugin.props" />
  <PropertyGroup>
    <AssemblyName>Stp3.SampleHello</AssemblyName>
    <RootNamespace>Stp3.Samples.Hello</RootNamespace>
    <PluginGuid>stp3.sample.hello</PluginGuid>
    <Version>0.1.0</Version>
  </PropertyGroup>
</Project>
