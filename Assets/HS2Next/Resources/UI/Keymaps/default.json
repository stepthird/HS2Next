{
  "version": 1,
  "name": "default",
  "bindings": {
    "edit.undo": ["Ctrl+Z"],
    "edit.redo": ["Ctrl+Y", "Ctrl+Shift+Z"],
    "edit.duplicate": ["Ctrl+D"],
    "edit.delete": ["Delete"],
    "edit.selectAll": ["Ctrl+A"],
    "edit.deselect": ["Escape"],
    "edit.rename": ["F2"],
    "edit.copyTransform": ["Ctrl+Shift+C"],
    "edit.pasteTransform": ["Ctrl+Shift+V"],
    "edit.moveToPivot": ["Shift+C"],
    "tool.select": ["Q"],
    "tool.move": ["W"],
    "tool.rotate": ["E"],
    "tool.scale": ["R"],
    "tool.space": ["X"],
    "tool.pivot": ["Period"],
    "tool.snapToggle": ["Shift+S"],
    "view.gizmos": ["Ctrl+Shift+G"],
    "view.panels": ["Shift+Space"],
    "view.hideSelected": ["H"],
    "view.showAll": ["Alt+H"],
    "camera.frame": ["F"],
    "camera.reset": ["Home"],
    "camera.resetAngles": ["Shift+Home"],
    "camera.moveLeft": ["LeftArrow"],
    "camera.moveRight": ["RightArrow"],
    "camera.moveForward": ["UpArrow"],
    "camera.moveBack": ["DownArrow"],
    "camera.moveUp": ["PageUp"],
    "camera.moveDown": ["PageDown"],
    "camera.dollyIn": ["Ctrl+UpArrow"],
    "camera.dollyOut": ["Ctrl+DownArrow"],
    "camera.orbitUp": ["Alt+UpArrow"],
    "camera.orbitDown": ["Alt+DownArrow"],
    "camera.orbitLeft": ["Alt+LeftArrow"],
    "camera.orbitRight": ["Alt+RightArrow"],
    "camera.fovDown": ["Ctrl+WheelUp"],
    "camera.fovUp": ["Ctrl+WheelDown"],
    "camera.slotLoad0": ["Alpha1"],
    "camera.slotLoad1": ["Alpha2"],
    "camera.slotLoad2": ["Alpha3"],
    "camera.slotLoad3": ["Alpha4"],
    "camera.slotLoad4": ["Alpha5"],
    "camera.slotLoad5": ["Alpha6"],
    "camera.slotLoad6": ["Alpha7"],
    "camera.slotLoad7": ["Alpha8"],
    "camera.slotLoad8": ["Alpha9"],
    "camera.slotLoad9": ["Alpha0"],
    "camera.slotSave0": ["Ctrl+Alpha1"],
    "camera.slotSave1": ["Ctrl+Alpha2"],
    "camera.slotSave2": ["Ctrl+Alpha3"],
    "camera.slotSave3": ["Ctrl+Alpha4"],
    "camera.slotSave4": ["Ctrl+Alpha5"],
    "camera.slotSave5": ["Ctrl+Alpha6"],
    "camera.slotSave6": ["Ctrl+Alpha7"],
    "camera.slotSave7": ["Ctrl+Alpha8"],
    "camera.slotSave8": ["Ctrl+Alpha9"],
    "camera.slotSave9": ["Ctrl+Alpha0"],
    "camera.lookThrough": ["Keypad0"],
    "add.cameraFromView": ["Ctrl+Keypad0"],
    "file.new": ["Ctrl+N"],
    "file.open": ["Ctrl+O"],
    "file.save": ["Ctrl+S"],
    "file.saveAs": ["Ctrl+Shift+S"],
    "help.keys": ["F1"],
    "time.pause": ["Space"],
    "capture.screenshot": ["F11"],
    "capture.dialog": ["Shift+F11"],
    "tree.prev": ["UpArrow"],
    "tree.next": ["DownArrow"],
    "tree.collapse": ["LeftArrow"],
    "tree.expand": ["RightArrow"],
    "gizmo.snapHold": ["Ctrl"],
    "gizmo.precisionHold": ["Shift"]
  },
  "notes": {
    "time.pause": "Global pause of the scene clock; time.step is unbound by default (toolbar button).",
    "camera.moveForward": "Held; Shift x5, Ctrl x0.2 only where no exact binding exists (Ctrl+Up is dollyIn).",
    "camera.fovDown": "Wheel chords are resolved by the viewport's wheel handler with the pseudo keys WheelUp / WheelDown.",
    "camera.slotLoad0": "Key 1 loads slot 0, ..., key 0 loads slot 9 (vanilla numbering).",
    "camera.lookThrough": "Looks through the selected camera object; on the camera in use, or with none selected, back to the free camera (v0.3 trial 2).",
    "tree.prev": "Tree scope: wins over the camera arrows only while the tree has focus.",
    "gizmo.snapHold": "Modifier action: held during a gizmo drag inverts the toolbar snap state."
  }
}
