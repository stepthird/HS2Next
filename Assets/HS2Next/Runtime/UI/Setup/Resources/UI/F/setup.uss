/* The first-run guide (setup mode) and its folder picker; the tokens of tokens-dark.uss. */
.hs-setup-root { background-color: var(--hs-bg-0); }
.hs-setup { flex-grow: 1; align-items: center; justify-content: center; padding: 16px; }
.hs-setup__card { width: 860px; max-width: 96%; max-height: 96%; flex-shrink: 1; padding: 20px 24px; background-color: var(--hs-bg-1); border-width: 1px; border-color: var(--hs-border); border-radius: 6px; }
.hs-setup__head { flex-direction: column; margin-bottom: 10px; }
.hs-setup__title { font-size: 22px; -unity-font-style: bold; color: var(--hs-text); }
.hs-setup__pageid { display: none; }
.hs-setup__body { flex-grow: 1; flex-shrink: 1; min-height: 200px; }
.hs-setup__nav { flex-direction: row; align-items: center; margin-top: 12px; }
.hs-setup__nav > .unity-button { min-width: 96px; height: 30px; margin-left: 6px; }
.hs-setup__default { background-color: var(--hs-accent-dim); border-color: var(--hs-accent); }
.hs-setup-text { white-space: normal; margin: 4px 0; }
.hs-setup-subtitle { -unity-font-style: bold; margin-top: 10px; margin-bottom: 4px; }
.hs-setup-path { white-space: normal; margin: 4px 0; padding: 4px 6px; background-color: var(--hs-bg-0); border-radius: 3px; }
.hs-setup-row { flex-direction: row; align-items: center; flex-wrap: wrap; margin: 4px 0; }
.hs-setup-row > .unity-button { margin-left: 4px; }
.hs-setup-list { margin: 4px 0; }
.hs-setup-list__item { -unity-text-align: middle-left; white-space: normal; }
.hs-setup-box { margin-top: 10px; padding: 8px; border-width: 1px; border-color: var(--hs-border); border-radius: 4px; }
.hs-setup-status { white-space: normal; margin: 4px 0; }
.hs-setup-status--ok { color: var(--hs-success); }
.hs-setup-status--warning { color: var(--hs-warning); }
.hs-setup-status--error { color: var(--hs-error); }
.hs-setup-choice { min-width: 140px; height: 30px; }
.hs-setup-choice--on { border-color: var(--hs-accent); background-color: var(--hs-accent-dim); }
.hs-setup-tip { margin-left: 10px; }
.hs-setup-picker-box { width: 720px; height: 560px; max-height: 85%; }
.hs-setup-picker-box > .hs-dialog__content { flex-grow: 1; }
.hs-setup-picker { flex-grow: 1; min-height: 0; }
.hs-setup-picker__list { flex-grow: 1; min-height: 120px; border-width: 1px; border-color: var(--hs-border); }
.hs-setup-picker__item { -unity-text-align: middle-left; margin: 0; border-radius: 0; border-width: 0; }
.hs-setup-banner { flex-direction: row; align-items: center; padding: 4px 10px; background-color: var(--hs-bg-3); border-bottom-width: 1px; border-color: var(--hs-warning); }
.hs-setup-banner > .unity-label { flex-grow: 1; color: var(--hs-warning); white-space: normal; }
