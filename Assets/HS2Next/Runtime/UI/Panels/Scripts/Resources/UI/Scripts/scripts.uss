/* The panel Scene scripts (Phase 6.9): the bars of buttons, the lists of the scene's scripts, the roles, the store and the last play; the script line of the Timeline panel's header. */
.hs-scripts { flex-grow: 1; flex-direction: column; background-color: var(--hs-bg-1); }
.hs-scripts__scroll { flex-grow: 1; }
.hs-scripts__bar { flex-direction: row; align-items: center; flex-wrap: wrap; flex-shrink: 0; padding: 2px 4px; }
.hs-scripts__list { flex-direction: column; flex-shrink: 0; padding: 0 4px; }
.hs-scripts__line { flex-direction: row; align-items: center; flex-wrap: wrap; min-height: 26px; padding: 0 2px; border-bottom-width: 1px; border-color: var(--hs-bg-0); }
.hs-scripts__line--selected { background-color: var(--hs-accent-dim); }
.hs-scripts__line--deleted { opacity: 0.6; }
.hs-scripts__line--uncast > .hs-scripts__cast { color: var(--hs-warning); }
.hs-scripts__text { flex-grow: 1; flex-shrink: 1; min-width: 32px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; -unity-text-align: middle-left; }
.hs-scripts__cell { flex-shrink: 0; margin: 0 6px 0 0; -unity-text-align: middle-left; }
.hs-scripts__dim { color: var(--hs-text-dim); }
.hs-scripts__cast { flex-shrink: 1; min-width: 80px; max-width: 220px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.hs-scripts__status { color: var(--hs-text-dim); white-space: normal; margin: 2px 4px; }
.hs-scripts__grow { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.hs-scripts__switch { flex-shrink: 0; margin-right: 8px; }
.hs-scripts__primary { -unity-font-style: bold; min-width: 64px; }
.hs-scripts__mark { color: var(--hs-accent); margin: 0 4px; }
.hs-scripts__warn { color: var(--hs-warning); }
.hs-scripts__dialog { min-width: 360px; }
.hs-tl__script { flex-direction: row; align-items: center; flex-wrap: wrap; min-height: 22px; }
.hs-tl__scriptname { -unity-font-style: bold; margin: 0 6px 0 2px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex-shrink: 1; }
.hs-tl__scriptedited { color: var(--hs-warning); margin: 0 6px; }
