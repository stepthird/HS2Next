/* The Wet and stains panel and section (Phase 6.6): the list of stains, the run buttons, the value rows. */
.hs-wet { flex-grow: 1; flex-direction: column; background-color: var(--hs-bg-1); }
.hs-wet__bar { flex-direction: row; align-items: center; flex-wrap: wrap; flex-shrink: 0; padding: 2px 4px; }
.hs-wet__scroll { flex-grow: 1; }
.hs-wet__line { flex-direction: row; align-items: center; height: 26px; padding: 0 2px; border-bottom-width: 1px; border-color: var(--hs-bg-0); }
.hs-wet__line--current { background-color: var(--hs-accent-dim); }
.hs-wet__name { flex-grow: 1; flex-shrink: 1; min-width: 32px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; -unity-text-align: middle-left; }
.hs-wet__state { flex-shrink: 1; min-width: 0; margin-left: 4px; padding: 0 4px; font-size: 10px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; border-radius: 3px; background-color: var(--hs-bg-3); color: var(--hs-text-dim); }
.hs-wet__btn { flex-shrink: 0; width: 20px; height: 20px; margin: 0 1px; padding: 0; }
.hs-wet__status { color: var(--hs-text-dim); white-space: normal; margin: 2px 4px; }
.hs-wet__warning { color: var(--hs-warning); white-space: normal; margin: 2px 4px; }
.hs-wet__row { flex-shrink: 0; }
.hs-wet__grow { flex-grow: 1; flex-shrink: 1; min-width: 0; }
