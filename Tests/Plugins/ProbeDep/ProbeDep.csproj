<Project Sdk="Microsoft.NET.Sdk">
  <!-- A private dependency of the probe plugin: staged into the plugin's lib folder and resolved by the loader. CC0-1.0. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <AssemblyName>Stp3.Test.ProbeDep</AssemblyName>
    <RootNamespace>Stp3.Test.ProbeDep</RootNamespace>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
</Project>
